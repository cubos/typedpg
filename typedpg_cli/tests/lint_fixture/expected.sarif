              }
            }
          ]
        },
        {
          "ruleId": "not_in_nullable",
          "level": "warning",
          "message": {
            "text": "NOT IN (SELECT …) returns no rows for a NULL left side when the subquery returns any row, or when the subquery returns a NULL\nuse NOT EXISTS (SELECT 1 FROM … WHERE …), or make both sides NOT NULL"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 44,
                  "endLine": 12,
                  "endColumn": 82
                }
              }
            }
          ]
        },
        {
          "ruleId": "unbounded_write",
          "level": "error",
          "message": {
            "text": "UPDATE without WHERE changes every row of users\nadd a WHERE clause, or allow it with -- typedpg-lint: allow(unbounded_write)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
