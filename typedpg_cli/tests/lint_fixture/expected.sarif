        },
        {
          "ruleId": "redundant_binding",
          "level": "warning",
          "message": {
            "text": "`id = id` binds `$id` to the variable it captures without a binding\nremove the binding: a parameter without one captures the variable of its name (`cargo typedpg lint --fix` removes it)"
          },
