{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "typedpg",
          "informationUri": "https://github.com/cubos/typedpg",
          "version": "0.5.0",
          "rules": [
            {
              "id": "null_comparison",
              "shortDescription": {
                "text": "comparison with NULL is never true"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "unbounded_write",
              "shortDescription": {
                "text": "UPDATE or DELETE without a WHERE clause"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "not_in_nullable",
              "shortDescription": {
                "text": "NOT IN (SELECT …) that returns no rows because a side may be NULL"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "create_index_blocking",
              "shortDescription": {
                "text": "CREATE INDEX without CONCURRENTLY on a table that already has rows"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "constraint_validating",
              "shortDescription": {
                "text": "a constraint that validates existing rows under a lock"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "set_not_null_scan",
              "shortDescription": {
                "text": "SET NOT NULL that scans every row of the table"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "table_rewrite",
              "shortDescription": {
                "text": "ALTER TABLE that rewrites every row under a lock"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "fk_without_index",
              "shortDescription": {
                "text": "a foreign key whose referencing columns have no index"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "redundant_index",
              "shortDescription": {
                "text": "an index another index on the table already covers"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "invalid_allow",
              "shortDescription": {
                "text": "a malformed or unknown rule name in a typedpg-lint comment"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "analysis_error",
              "shortDescription": {
                "text": "the query or migration could not be analyzed"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "columnKind": "unicodeCodePoints",
      "results": [
        {
          "ruleId": "create_index_blocking",
          "level": "warning",
          "message": {
            "text": "CREATE INDEX without CONCURRENTLY blocks writes on public.users for the whole build\nuse CREATE INDEX CONCURRENTLY, in a migration whose first line is -- no-transaction"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "migrations/0002_hazards.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1,
                  "endLine": 3,
                  "endColumn": 44
                }
              }
            }
          ]
        },
        {
          "ruleId": "constraint_validating",
          "level": "warning",
          "message": {
            "text": "adding a constraint validates every row of public.posts under a lock\nadd it NOT VALID, then VALIDATE CONSTRAINT in a later migration"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "migrations/0002_hazards.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1,
                  "endLine": 6,
                  "endColumn": 50
                }
              }
            }
          ]
        },
        {
          "ruleId": "fk_without_index",
          "level": "warning",
          "message": {
            "text": "foreign key posts_author_fk on public.posts (author_id) has no index\nCREATE INDEX ON public.posts (author_id)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "migrations/0002_hazards.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1,
                  "endLine": 6,
                  "endColumn": 50
                }
              }
            }
          ]
        },
        {
          "ruleId": "null_comparison",
          "level": "error",
          "message": {
            "text": "comparison with NULL is never true\nuse IS NULL / IS NOT NULL"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 45,
                  "endLine": 8,
                  "endColumn": 57
                }
              }
            }
          ]
        },
        {
          "ruleId": "null_comparison",
          "level": "error",
          "message": {
            "text": "comparison with NULL is never true\nuse IS NULL / IS NOT NULL"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 46,
                  "endLine": 10,
                  "endColumn": 58
                }
              }
            }
          ]
        },
        {
          "ruleId": "not_in_nullable",
          "level": "warning",
          "message": {
            "text": "NOT IN (SELECT …) returns no rows when either side is NULL\nuse NOT EXISTS (SELECT 1 FROM … WHERE …), or make both sides NOT NULL"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 44,
                  "endLine": 12,
                  "endColumn": 82
                }
              }
            }
          ]
        },
        {
          "ruleId": "unbounded_write",
          "level": "error",
          "message": {
            "text": "UPDATE without WHERE changes every row of users\nadd a WHERE clause, or allow it with -- typedpg-lint: allow(unbounded_write)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 17,
                  "endLine": 16,
                  "endColumn": 29
                }
              }
            }
          ]
        },
        {
          "ruleId": "null_comparison",
          "level": "error",
          "message": {
            "text": "comparison with NULL is never true\nuse IS NULL / IS NOT NULL"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 18,
                  "startColumn": 57,
                  "endLine": 18,
                  "endColumn": 68
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
