{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "typedpg",
          "informationUri": "https://github.com/cubos/typedpg",
          "version": "0.8.0",
          "rules": [
            {
              "id": "null_comparison",
              "shortDescription": {
                "text": "comparison with NULL is never true"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/null_comparison.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "unbounded_write",
              "shortDescription": {
                "text": "UPDATE or DELETE without a WHERE clause"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/unbounded_write.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "not_in_nullable",
              "shortDescription": {
                "text": "NOT IN (SELECT …) that returns no rows because a side may be NULL"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/not_in_nullable.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "create_index_blocking",
              "shortDescription": {
                "text": "CREATE INDEX without CONCURRENTLY on a table that already has rows"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/create_index_blocking.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "add_constraint_scan",
              "shortDescription": {
                "text": "a constraint that validates existing rows under a lock"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/add_constraint_scan.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "set_not_null_scan",
              "shortDescription": {
                "text": "SET NOT NULL that scans every row of the table"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/set_not_null_scan.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "alter_table_rewrite",
              "shortDescription": {
                "text": "ALTER TABLE that rewrites every row under a lock"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/alter_table_rewrite.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "fk_without_index",
              "shortDescription": {
                "text": "a foreign key whose referencing columns have no index"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/fk_without_index.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "performance"
                ]
              }
            },
            {
              "id": "redundant_index",
              "shortDescription": {
                "text": "an index another index on the table already covers"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_index.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "performance"
                ]
              }
            },
            {
              "id": "redundant_binding",
              "shortDescription": {
                "text": "a `sql!` binding the parameter would capture without it"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_binding.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "renaming_binding",
              "shortDescription": {
                "text": "a `sql!` binding that only renames a variable"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/renaming_binding.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "redundant_null_check",
              "shortDescription": {
                "text": "IS [NOT] NULL or COALESCE on a value that is never NULL"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_null_check.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "limit_without_order",
              "shortDescription": {
                "text": "LIMIT, OFFSET or DISTINCT ON without ORDER BY picks arbitrary rows"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/limit_without_order.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "redundant_limit",
              "shortDescription": {
                "text": "a LIMIT on a query that returns at most one row"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_limit.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "redundant_distinct",
              "shortDescription": {
                "text": "a DISTINCT on rows that are already distinct"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_distinct.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "constant_condition",
              "shortDescription": {
                "text": "a condition that is always true or never true"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/constant_condition.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "unreachable_case_branch",
              "shortDescription": {
                "text": "a CASE branch that is never taken"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/unreachable_case_branch.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "case_without_else",
              "shortDescription": {
                "text": "a CASE without ELSE whose WHENs may all be false, which makes it NULL"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/case_without_else.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "style"
                ]
              }
            },
            {
              "id": "redundant_cast",
              "shortDescription": {
                "text": "a cast to the type its operand already has"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_cast.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "redundant_alias",
              "shortDescription": {
                "text": "an output column alias that names the column what it already is"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_alias.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "outer_reference_in_subquery",
              "shortDescription": {
                "text": "an unqualified column reference in a subquery that resolves to an outer query"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/outer_reference_in_subquery.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "cartesian_join",
              "shortDescription": {
                "text": "FROM items joined with no condition connecting them"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/cartesian_join.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "insert_without_columns",
              "shortDescription": {
                "text": "an INSERT without a column list"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/insert_without_columns.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "self_assignment",
              "shortDescription": {
                "text": "an UPDATE that assigns a column its own value"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/self_assignment.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "unused_cte",
              "shortDescription": {
                "text": "a WITH query nothing references"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/unused_cte.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "simplifiable_case",
              "shortDescription": {
                "text": "a CASE that is a COALESCE or its own condition"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/simplifiable_case.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "like_unescaped_param",
              "shortDescription": {
                "text": "a LIKE pattern built from a parameter whose % and _ are not escaped"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/like_unescaped_param.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "redundant_join",
              "shortDescription": {
                "text": "a join that can't change the rows and whose table nothing else reads"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_join.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "scalar_subquery_multiple_rows",
              "shortDescription": {
                "text": "a scalar subquery used as a value that may return more than one row"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/scalar_subquery_multiple_rows.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "timestamp_timezone_mix",
              "shortDescription": {
                "text": "an implicit timestamp/timestamptz conversion that depends on the session's TimeZone"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/timestamp_timezone_mix.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "integer_division",
              "shortDescription": {
                "text": "an integer division whose truncated result is used as a non-integer value"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/integer_division.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "left_join_nullified",
              "shortDescription": {
                "text": "an outer join the WHERE clause turns into an inner join by rejecting its null-extended rows"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/left_join_nullified.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "check_violation",
              "shortDescription": {
                "text": "an INSERT or UPDATE storing a constant a CHECK constraint rejects"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/check_violation.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "unstable_order",
              "shortDescription": {
                "text": "an ORDER BY with LIMIT, OFFSET or DISTINCT ON whose keys can tie"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/unstable_order.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "redundant_order_by",
              "shortDescription": {
                "text": "ORDER BY keys that can't change the order of the rows"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_order_by.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "redundant_group_by",
              "shortDescription": {
                "text": "GROUP BY keys determined by the other keys or pinned to a constant"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_group_by.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "redundant_count_argument",
              "shortDescription": {
                "text": "count(expr) over a value that is never NULL, which is count(*)"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/redundant_count_argument.md",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "redundant"
                ]
              }
            },
            {
              "id": "non_sargable_predicate",
              "shortDescription": {
                "text": "a comparison wrapping an indexed column so its index can't serve it"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/non_sargable_predicate.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "performance"
                ]
              }
            },
            {
              "id": "float_equality",
              "shortDescription": {
                "text": "an equality comparison of floating-point values"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/float_equality.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "fk_type_mismatch",
              "shortDescription": {
                "text": "a foreign key whose column types differ from the referenced columns"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/fk_type_mismatch.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "performance"
                ]
              }
            },
            {
              "id": "lock_without_timeout",
              "shortDescription": {
                "text": "a migration taking a blocking lock on an existing table without SET lock_timeout"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/lock_without_timeout.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "drop_index_blocking",
              "shortDescription": {
                "text": "DROP INDEX without CONCURRENTLY on a table that already has rows"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/drop_index_blocking.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "rebuild_blocking",
              "shortDescription": {
                "text": "REINDEX, VACUUM FULL, CLUSTER or REPACK holding a blocking lock for the whole rebuild"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/rebuild_blocking.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "detach_partition_blocking",
              "shortDescription": {
                "text": "DETACH PARTITION without CONCURRENTLY on a table that already has rows"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/detach_partition_blocking.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "validate_constraint_blocking",
              "shortDescription": {
                "text": "VALIDATE CONSTRAINT in the transaction that added the constraint NOT VALID"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/validate_constraint_blocking.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "attach_partition_scan",
              "shortDescription": {
                "text": "ATTACH PARTITION scanning the partition because its constraints don't imply its bound, or scanning the default partition"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/attach_partition_scan.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "locking"
                ]
              }
            },
            {
              "id": "table_without_primary_key",
              "shortDescription": {
                "text": "a table without a primary key"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/table_without_primary_key.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "suspicious"
                ]
              }
            },
            {
              "id": "policy_without_rls",
              "shortDescription": {
                "text": "row-level security policies on a table that does not enable row-level security"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/policy_without_rls.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "rls_without_policy",
              "shortDescription": {
                "text": "row-level security enabled on a table with no policy"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/rls_without_policy.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "security_definer_without_search_path",
              "shortDescription": {
                "text": "a SECURITY DEFINER routine without SET search_path"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/security_definer_without_search_path.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security"
                ]
              }
            },
            {
              "id": "prefer_timestamptz",
              "shortDescription": {
                "text": "a timestamp without time zone column"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/prefer_timestamptz.md",
              "defaultConfiguration": {
                "level": "none"
              },
              "properties": {
                "tags": [
                  "pedantic"
                ]
              }
            },
            {
              "id": "prefer_identity",
              "shortDescription": {
                "text": "a serial column instead of an identity column"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/prefer_identity.md",
              "defaultConfiguration": {
                "level": "none"
              },
              "properties": {
                "tags": [
                  "pedantic"
                ]
              }
            },
            {
              "id": "prefer_text",
              "shortDescription": {
                "text": "a varchar(n) or char(n) column instead of text"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/prefer_text.md",
              "defaultConfiguration": {
                "level": "none"
              },
              "properties": {
                "tags": [
                  "pedantic"
                ]
              }
            },
            {
              "id": "prefer_bigint_pk",
              "shortDescription": {
                "text": "an int2 or int4 primary key"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/prefer_bigint_pk.md",
              "defaultConfiguration": {
                "level": "none"
              },
              "properties": {
                "tags": [
                  "pedantic"
                ]
              }
            },
            {
              "id": "prefer_jsonb",
              "shortDescription": {
                "text": "a json column instead of jsonb"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/prefer_jsonb.md",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "performance"
                ]
              }
            },
            {
              "id": "fetch_one_multiple_rows",
              "shortDescription": {
                "text": "fetch_one / fetch_optional on a query not proven to return at most one row"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/fetch_one_multiple_rows.md",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "correctness"
                ]
              }
            },
            {
              "id": "fetch_all_single_row",
              "shortDescription": {
                "text": "fetch_all on a query that returns at most one row"
              },
              "helpUri": "https://github.com/cubos/typedpg/blob/main/docs/lint/fetch_all_single_row.md",
