{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "typedpg",
          "informationUri": "https://github.com/cubos/typedpg",
          "version": "0.7.2",
          "rules": [
            {
              "id": "null_comparison",
              "shortDescription": {
                "text": "comparison with NULL is never true"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "unbounded_write",
              "shortDescription": {
                "text": "UPDATE or DELETE without a WHERE clause"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "not_in_nullable",
              "shortDescription": {
                "text": "NOT IN (SELECT …) that returns no rows because a side may be NULL"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "create_index_blocking",
              "shortDescription": {
                "text": "CREATE INDEX without CONCURRENTLY on a table that already has rows"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "constraint_validating",
              "shortDescription": {
                "text": "a constraint that validates existing rows under a lock"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "set_not_null_scan",
              "shortDescription": {
                "text": "SET NOT NULL that scans every row of the table"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "table_rewrite",
              "shortDescription": {
                "text": "ALTER TABLE that rewrites every row under a lock"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "fk_without_index",
              "shortDescription": {
                "text": "a foreign key whose referencing columns have no index"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "redundant_index",
              "shortDescription": {
                "text": "an index another index on the table already covers"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "redundant_binding",
              "shortDescription": {
                "text": "a `sql!` binding the parameter would capture without it"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "renaming_binding",
              "shortDescription": {
                "text": "a `sql!` binding that only renames a variable"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "redundant_null_check",
              "shortDescription": {
                "text": "IS [NOT] NULL or COALESCE on a value that is never NULL"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "limit_without_order",
              "shortDescription": {
                "text": "LIMIT, OFFSET or DISTINCT ON without ORDER BY picks arbitrary rows"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "redundant_limit",
              "shortDescription": {
                "text": "a LIMIT on a query that returns at most one row"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "redundant_distinct",
              "shortDescription": {
                "text": "a DISTINCT on rows that are already distinct"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "like_unescaped_param",
              "shortDescription": {
                "text": "a LIKE pattern built from a parameter whose % and _ are not escaped"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "fk_type_mismatch",
              "shortDescription": {
                "text": "a foreign key whose column types differ from the referenced columns"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "missing_lock_timeout",
              "shortDescription": {
                "text": "a migration taking a blocking lock on an existing table without SET lock_timeout"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "prefer_timestamptz",
              "shortDescription": {
                "text": "a timestamp without time zone column"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "prefer_identity",
              "shortDescription": {
                "text": "a serial column instead of an identity column"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "prefer_text",
              "shortDescription": {
                "text": "a varchar(n) or char(n) column instead of text"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "prefer_bigint_pk",
              "shortDescription": {
                "text": "an int2 or int4 primary key"
              },
              "defaultConfiguration": {
                "level": "none"
              }
            },
            {
              "id": "fetch_may_return_many",
              "shortDescription": {
                "text": "fetch_one / fetch_optional on a query not proven to return at most one row"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "fetch_all_single_row",
              "shortDescription": {
                "text": "fetch_all on a query that returns at most one row"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "unused_returning",
              "shortDescription": {
                "text": "execute() on a statement whose RETURNING rows are discarded"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "invalid_allow",
              "shortDescription": {
                "text": "a malformed or unknown rule name in a typedpg-lint comment"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "internal_error",
              "shortDescription": {
                "text": "a typedpg bug: a fix that would have changed the query"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "analysis_error",
              "shortDescription": {
                "text": "the query or migration could not be analyzed"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": false
        }
      ],
      "columnKind": "unicodeCodePoints",
      "results": [
        {
          "ruleId": "create_index_blocking",
          "level": "warning",
          "message": {
            "text": "CREATE INDEX without CONCURRENTLY blocks writes on public.users for the whole build\nuse CREATE INDEX CONCURRENTLY, in a migration whose first line is -- no-transaction"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "migrations/0002_hazards.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1,
                  "endLine": 3,
                  "endColumn": 44
                }
              }
            }
          ]
        },
        {
          "ruleId": "constraint_validating",
          "level": "warning",
          "message": {
            "text": "adding a constraint validates every row of public.posts under a lock\nadd it NOT VALID, then VALIDATE CONSTRAINT in a later migration"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "migrations/0002_hazards.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1,
                  "endLine": 6,
                  "endColumn": 50
                }
              }
            }
          ]
        },
        {
          "ruleId": "fk_without_index",
          "level": "warning",
          "message": {
            "text": "foreign key posts_author_fk on public.posts (author_id) has no index\nCREATE INDEX ON public.posts (author_id)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "migrations/0002_hazards.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 1,
                  "endLine": 6,
                  "endColumn": 50
                }
              }
            }
          ]
        },
        {
          "ruleId": "create_index_blocking",
          "level": "warning",
          "message": {
            "text": "CREATE INDEX without CONCURRENTLY blocks writes on public.things for the whole build\nuse CREATE INDEX CONCURRENTLY, in a migration whose first line is -- no-transaction"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "other_migrations/0002_hazards.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 1,
                  "endLine": 3,
                  "endColumn": 46
                }
              }
            }
          ]
        },
        {
          "ruleId": "null_comparison",
          "level": "error",
          "message": {
            "text": "comparison with NULL is never true\nuse IS NULL / IS NOT NULL"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 45,
                  "endLine": 8,
