{
  "name": "@cubos/typedpg",
  "version": "0.5.0",
  "description": "Typed PostgreSQL queries for TypeScript, checked against your migrations without a database",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubos/typedpg.git",
    "directory": "typedpg_npm"
  },
  "keywords": ["postgres", "postgresql", "sql", "typescript", "typed", "pg", "postgres.js"],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "!dist/*.test.*"],
  "sideEffects": ["./dist/register.js", "./dist/bun.js"],
  "scripts": {
    "build": "node scripts/wasm.mjs && rm -rf dist && tsc -p .",
    "test": "npm run build && node --test dist/*.test.js",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "pg": ">=8.11",
    "pg-copy-streams": ">=6",
    "pg-cursor": ">=2.10",
    "postgres": ">=3.4 <4"
  },
  "peerDependenciesMeta": {
    "pg": { "optional": true },
    "pg-copy-streams": { "optional": true },
    "pg-cursor": { "optional": true },
    "postgres": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  }
}
