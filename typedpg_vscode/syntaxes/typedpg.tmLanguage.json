{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "inline.sql.typedpg",
  "injectionSelector": "L:source.rust",
  "patterns": [
    {
      "comment": "Match sql! macro invocation (single and multi-line)",
      "begin": "\\bsql!\\s*\\(",
      "end": "\\)",
      "patterns": [
        {
          "comment": "Raw string literal containing SQL: it ends at a quote followed by as many # as it opened with",
          "name": "meta.embedded.sql.typedpg",
          "begin": "(r(\\#*)\")",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.sql.typedpg" }
          },
          "end": "(\"\\2)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.sql.typedpg" }
          },
          "contentName": "meta.embedded.sql",
          "patterns": [
            { "include": "#spread-param" },
            { "include": "#named-param" },
            { "include": "source.sql" }
          ]
        },
        {
          "comment": "Regular string literal containing SQL",
          "name": "meta.embedded.sql.typedpg",
          "begin": "(\")",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.sql.typedpg" }
          },
          "end": "(\")",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.sql.typedpg" }
          },
          "contentName": "meta.embedded.sql",
          "patterns": [
            { "include": "#escape" },
            { "include": "#spread-param" },
            { "include": "#named-param" },
            { "include": "source.sql" }
          ]
        }
      ]
    }
  ],
  "repository": {
    "escape": {
      "comment": "A Rust escape (\\\", \\n, a line continuation…) in a regular string: never the string's end, nor SQL's",
      "name": "constant.character.escape.rust",
      "match": "\\\\(?:x\\h{2}|u\\{\\h+\\}|.|$)"
    },
    "spread-param": {
      "comment": "Matches $..identifier and optionally $..identifier { field1, field2 }",
      "name": "variable.spread.typedpg",
      "match": "\\$\\.\\.([a-zA-Z_][a-zA-Z0-9_]*)(\\s*\\{[^}]*\\})?"
    },
    "named-param": {
      "comment": "Matches $identifier (but not $..identifier which is handled above)",
      "name": "variable.parameter.typedpg",
      "match": "\\$(?!\\.\\.)([a-zA-Z_][a-zA-Z0-9_]*[?!]?)"
    }
  }
}
