{
  "name": "typedpg",
  "displayName": "typedpg",
  "description": "SQL syntax highlighting inside typedpg sql! macros (Rust) and sql() / copyIn() calls (TypeScript); errors of .sql files through TypeScript 7.1's content mapper",
  "version": "0.4.0",
  "publisher": "cubos",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:sql", "workspaceContains:**/typedpg.config.json"],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": true }
  },
  "configurationDefaults": {
    "rust-analyzer.semanticHighlighting.strings.enable": false
  },
  "contributes": {
    "grammars": [
      {
        "injectTo": ["source.rust"],
        "scopeName": "inline.sql.typedpg",
        "path": "./syntaxes/typedpg.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.sql": "sql"
        }
      },
      {
        "injectTo": ["source.ts", "source.tsx"],
        "scopeName": "inline.sql.typedpg.ts",
        "path": "./syntaxes/typedpg-ts.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.sql": "sql"
        }
      }
    ]
  }
}
