{
  "name": "@cubos/typedpg-cli",
  "version": "0.5.0",
  "description": "The typedpg command and bundler plugins for TypeScript, checked against your migrations without a database",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubos/typedpg.git",
    "directory": "typedpg_npm_cli"
  },
  "keywords": ["postgres", "postgresql", "sql", "typescript", "typed", "pg", "esbuild", "vite", "rollup", "webpack"],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "typedpg": "bin/typedpg.js"
  },
  "files": ["dist", "!dist/*.test.*", "bin"],
  "typescript": {
    "contentMapper": {
      "exec": ["node", "bin/typedpg.js", "serve"],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@cubos/typedpg": "file:../typedpg_npm"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0"
  }
}
